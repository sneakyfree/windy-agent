# ~/.config/windy-gateway.env — copy from this file, chmod 600.
# Loopback only; cloudflared is the only way in from outside.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3000
WINDYFLY_ENV=production
# The owner's hub identity (the claim the gateway matches; see README).
# Production refuses to start without it.
WINDY_IDENTITY_ID=
# Hub OAuth public client for loopback/hosted PKCE sign-in (registered by the hub lane).
HUB_OAUTH_CLIENT_ID=windy-fly-dashboard
# Contract v1: aud enforcement stays OFF until the hub lane flips it.
WINDY_FLY_ENFORCE_AUDIENCE=0
# Windy 0's Python bridge socket (windytalk-agent-bridge.service).
WINDYFLY_IPC_PATH=/tmp/wt-agent-bridge.sock
# The Python side verifies trust webhooks; production fails closed without this.
# (Read by the bridge process, listed here so the go-live checklist is in one place.)
# ETERNITAS_WEBHOOK_SECRET=  -> put in ~/.windy/windy-0.env, NOT here
